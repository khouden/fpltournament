generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tournament {
  id           String   @id @default(cuid())
  name         String
  season       Int
  adminFplId   Int
  allowChips   Boolean  @default(true) // Whether FPL chips (TC, BB) count fully or are adjusted
  status       String   @default("DRAFT") // DRAFT, PUBLISHED, FINISHED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  groups       Group[]
  rounds       Round[]

  @@index([status])
  @@index([adminFplId])
}

model Group {
  id           String   @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String
  fplLeagueId  Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members      GroupMember[]
  homeMatches  Match[] @relation("HomeGroup")
  awayMatches  Match[] @relation("AwayGroup")
  wonMatches   Match[] @relation("WinnerGroup")

  @@index([tournamentId])
}

model GroupMember {
  id           String   @id @default(cuid())
  groupId      String
  group        Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fplName      String
  fplTeamName  String?
  fplId        Int
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())

  matchScores  MatchMemberScore[]

  @@index([groupId])
  @@unique([groupId, fplId])
}

model Round {
  id           String   @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String?
  roundNumber  Int
  gameweek     Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  matches      Match[]

  @@index([tournamentId])
  @@unique([tournamentId, roundNumber])
}

model Match {
  id              String   @id @default(cuid())
  roundId         String
  round           Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  matchNumber     Int
  status          String   @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED, FINALIZED

  // Group-vs-group: home and away sides
  homeGroupId     String?
  homeGroup       Group?   @relation("HomeGroup", fields: [homeGroupId], references: [id])
  awayGroupId     String?
  awayGroup       Group?   @relation("AwayGroup", fields: [awayGroupId], references: [id])

  // For knockout rounds: reference to the match whose winner fills this slot
  homeWinnerOfMatchId  String?  // "Winner of Match X" — match ID
  awayWinnerOfMatchId  String?  // "Winner of Match Y" — match ID

  // Scores
  homeScore       Float?
  awayScore       Float?

  // Result
  winnerId        String?
  winner          Group?   @relation("WinnerGroup", fields: [winnerId], references: [id])
  result          String?  // HOME_WIN, AWAY_WIN, DRAW

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  scores          MatchMemberScore[]

  @@index([roundId])
  @@index([status])
}

model MatchMemberScore {
  id           String   @id @default(cuid())
  matchId      String
  match        Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  memberId     String
  member       GroupMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  gameweekPoints Int     @default(0)
  isExcluded   Boolean  @default(false) // true for admin members
  activeChip   String?  // bboost, 3xc, wildcard, freehit
  chipDeduction Int     @default(0) // points deducted if chips are disabled

  isFinal      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([matchId])
  @@index([memberId])
  @@unique([matchId, memberId])
}
