# Database
DATABASE_URL="file:./dev.db"

# Admin Authentication & Security
# AUTH_SECRET should be a strong 32+ character random string in production (e.g. openssl rand -hex 32)
AUTH_SECRET="your-32-plus-character-cryptographic-auth-secret-here"
ADMIN_EMAIL="admin@tournament.local"

# Use ADMIN_PASSWORD_HASH for production (generate with: npx tsx scripts/generate-password-hash.ts "your-password")
ADMIN_PASSWORD_HASH="pbkdf2$sha256$100000$..."

# For development only fallback
ADMIN_PASSWORD="admin123"

# For production database, e.g. Turso:
# DATABASE_URL="libsql://your-db-name.turso.io?authToken=your-token"
